generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  type      String
  category  String
  date      String
  createdAt DateTime @default(now())
}

model RecurringItem {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  type       String
  category   String
  dayOfMonth Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SavingGoal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  icon         String
  deadline     String?
  createdAt    DateTime @default(now())
}

model Installment {
  id           String   @id @default(cuid())
  name         String
  totalAmount  Float
  tenure       Int // -1 = unlimited
  interestRate Float    @default(0)
  source       String
  description  String   @default("")
  type         String
  startDate    String
  createdAt    DateTime @default(now())
}

model InstallmentPayment {
  id            String   @id @default(cuid())
  installmentId String
  amount        Float
  monthKey      String // YYYY-MM
  createdAt     DateTime @default(now())
}

model Balance {
  id        String   @id @default(cuid())
  name      String   @unique
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
