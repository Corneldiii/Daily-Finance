generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id        String   @id @default(cuid())
  title     String
  amount    Float
  type      String
  category  String
  date      String
  createdAt DateTime @default(now())
}

model RecurringItem {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  type       String
  category   String
  dayOfMonth Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SavingGoal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  icon         String
  deadline     String?
  createdAt    DateTime @default(now())
}